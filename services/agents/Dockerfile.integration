FROM python:3.11-slim

WORKDIR /app

COPY packages/agent-contract /packages/agent-contract
RUN pip install --no-cache-dir /packages/agent-contract

COPY services/agents/opportunityalert/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY services/agents/opportunityalert /app

ENV PORT=8017
EXPOSE 8017

CMD uvicorn main:app --host 0.0.0.0 --port ${PORT}
