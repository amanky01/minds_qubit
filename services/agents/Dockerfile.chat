FROM python:3.11-slim

ARG AGENT_DIR=codecraft
ARG AGENT_PORT=8010

WORKDIR /app

COPY packages/agent-contract /packages/agent-contract
RUN pip install --no-cache-dir /packages/agent-contract

COPY services/agents/_shared /app/shared
COPY services/agents/_shared/requirements.txt /tmp/requirements.txt
RUN pip install --no-cache-dir -r /tmp/requirements.txt

COPY services/agents/${AGENT_DIR} /app/agent

ENV PYTHONPATH=/app/shared:/app/agent
ENV AGENT_ID=${AGENT_DIR}
ENV PORT=${AGENT_PORT}

WORKDIR /app/agent
EXPOSE ${AGENT_PORT}

CMD uvicorn main:app --host 0.0.0.0 --port ${PORT}
