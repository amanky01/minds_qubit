# ── MongoDB ──────────────────────────────────────────────────────────
MONGODB_URL=mongodb://localhost:27017
CENTRAL_DB_NAME=mindsqubit_core

# ── JWT (generate a strong secret for production) ─────────────────────
JWT_SECRET_KEY=change_me_to_a_long_random_string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Agent microservices ───────────────────────────────────────────────
AGENT_CODECRAFT_URL=http://localhost:8010
AGENT_DATAVIZ_URL=http://localhost:8011
AGENT_CONTENTCREATOR_URL=http://localhost:8012
AGENT_DESIGNMASTER_URL=http://localhost:8013
AGENT_LANGUAGETUTOR_URL=http://localhost:8014
AGENT_RESEARCHPRO_URL=http://localhost:8015
AGENT_TECHBLOG_URL=http://localhost:8016
AGENT_OPPORTUNITYALERT_URL=http://localhost:8017

# Gemini + OPPORTUNITY_CRAWLER_URL belong in agent service env (see services/agents/.env.example)

# ── OAuth (optional) ──────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
OAUTH_REDIRECT_URL=http://localhost:8000/api/v1/auth/oauth

# ── CORS ──────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000

# ── Plans ─────────────────────────────────────────────────────────────
DEFAULT_PLAN_ID=free

# ── Server ────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
